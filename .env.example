# OmniNexus local configuration.
# Copy this file to `.env` and fill only the providers you use.
# `.env` is git-ignored and is never uploaded by OmniNexus.
# Never put real keys in `.env.example`, config/*.yaml, docs or commits.

# --- Server ---
OMNI_HOST=127.0.0.1
OMNI_PORT=8000
# OMNI_CONFIG=./config/default.yaml

# --- Optional: use a non-default data directory (SQLite archive, outbox) ---
# OMNI_DATA_DIR=./data

# --- Cloud providers (BYOK; leave unused ones blank) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
QIANFAN_API_KEY=
SPARK_API_KEY=
HUNYUAN_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=

# --- Web search (optional; only the search query is sent) ---
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# SEARXNG_BASE_URL=http://127.0.0.1:8888

# --- External memory pipeline (Reserved; disabled by default) ---
# OMNI_MEMORY_ENABLED=1
# OMNI_MEMORY_BASE_URL=http://127.0.0.1:8788
# OMNI_MEMORY_TOKEN=

# --- Local providers (no key required; disabled until enabled) ---
# OMNI_ENABLE_LOCAL=1
# Or set enabled: true for one provider in config/default.yaml.
# Ollama: http://127.0.0.1:11434/v1
# LM Studio: http://127.0.0.1:1234/v1
# vLLM: http://127.0.0.1:8000/v1
# llama.cpp: http://127.0.0.1:8080/v1

# --- Offline diagnostic model (disabled by default; no personality) ---
# OMNI_ENABLE_ECHO=1
